-    fun bytesToBase64(bytes: ByteArray): String {
-        return Base64.encodeToString(bytes, Base64.NO_WRAP)
-    }
-
-    /**
-     * Decodifica una cadena Base64 a un archivo local y retorna la ruta absoluta.
